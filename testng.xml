<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Playwright Automation Suite" parallel="tests" thread-count="2">

	<listeners>

		<listener class-name="com.framework.listeners.TestListener" />
	</listeners>

	<test name="Regression">

		<classes>

			<class name="com.framework.tests.LoginTest" />
			<class name="com.framework.tests.E2ETest" />

		</classes>

	</test>

</suite>